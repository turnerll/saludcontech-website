---
import { SCT_FACTS } from '../data/sctFacts';

const { approved, members, cityChapters, latinoBusinessRevenue } = SCT_FACTS;

// Bars: label, value (pct), color role, source note.
const bars = [
  { label: 'Latino share of US population by 2045', value: approved.latinoPopulation2045Pct, role: 'moss', note: 'Census projection' },
  { label: 'Latino founders share of VC funding', value: approved.latinoFounderVcSharePct, role: 'clay', note: 'Industry estimate' },
  { label: 'Latino professionals in VC', value: approved.latinoVcProfessionalsPct, role: 'maroon', note: 'Industry estimate' },
];
---

<section class="section-block alt" id="data">
  <div class="container-narrow">
    <div class="section-head center">
      <span class="label">The numbers</span>
      <h2 class="headline">Trillions in economic output. Single digits in ownership.</h2>
      <p class="lede">
        Latino economic output is larger than the GDP of every country except the US and China. Yet Latino founders receive about 2% of venture funding and hold about 2% of VC jobs. These are the numbers that drive our work.
      </p>
    </div>

    <div class="viz-grid">
      <div class="barchart">
        <h3>Latino share of capital and population</h3>
        <p class="barchart-sub">Where demographics are headed versus where capital still sits.</p>

        <div class="bar-rows" id="sctBars">
          {bars.map((b) => (
            <div class="bar-row">
              <div class="bar-label">
                {b.label}
                <small>{b.note}</small>
              </div>
              <div class="bar-track">
                <div class={`bar-fill ${b.role}`} data-width={b.value} style={`width: 0%;`}></div>
              </div>
              <div class="bar-value">{b.value}%</div>
            </div>
          ))}
        </div>
      </div>

      <div class="stat-cards">
        <div class="stat-card">
          <span class="stat-num anim-num" data-target={members.value} data-suffix="+">0</span>
          <span class="stat-lbl">Community members</span>
        </div>
        <div class="stat-card">
          <span class="stat-num anim-num" data-target={approved.latinoGdpTrillions} data-decimals="1" data-prefix="$" data-suffix="T">$0T</span>
          <span class="stat-lbl">Latino US GDP</span>
        </div>
        <div class="stat-card">
          <span class="stat-num anim-num" data-target={latinoBusinessRevenue.value} data-prefix="$" data-suffix="B">$0B</span>
          <span class="stat-lbl">Latino-owned business revenue</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    // Bar animation
    var barsWrap = document.getElementById('sctBars');
    if (barsWrap) {
      var fills = barsWrap.querySelectorAll('.bar-fill');

      function fireBars() {
        fills.forEach(function (f) {
          f.style.width = (parseFloat(f.dataset.width) || 0) + '%';
        });
      }

      function inView(el) {
        var r = el.getBoundingClientRect();
        return r.top < (window.innerHeight || document.documentElement.clientHeight) && r.bottom > 0;
      }

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        fireBars();
      } else if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { fireBars(); io.unobserve(barsWrap); }
          });
        }, { threshold: 0.25 });
        io.observe(barsWrap);
        if (inView(barsWrap)) fireBars();
        setTimeout(fireBars, 2000);
      } else {
        fireBars();
      }
    }

    // Count-up animation
    var nodes = document.querySelectorAll('.anim-num');
    if (!nodes.length) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function fmt(n, dec) {
      return dec > 0 ? n.toFixed(dec) : Math.round(n).toString();
    }

    function run(el) {
      var target = parseFloat(el.dataset.target);
      var dec = parseInt(el.dataset.decimals || '0', 10);
      var prefix = el.dataset.prefix || '';
      var suffix = el.dataset.suffix || '';
      if (isNaN(target)) return;
      if (reduced) { el.textContent = prefix + fmt(target, dec) + suffix; return; }

      var dur = 1400;
      var t0 = performance.now();
      function step(now) {
        var p = Math.min(1, (now - t0) / dur);
        var eased = 1 - Math.pow(1 - p, 3);
        var v = target * eased;
        el.textContent = prefix + fmt(v, dec) + suffix;
        if (p < 1) requestAnimationFrame(step);
      }
      el.textContent = prefix + fmt(0, dec) + suffix;
      requestAnimationFrame(step);
      setTimeout(function () { el.textContent = prefix + fmt(target, dec) + suffix; }, dur + 300);
    }

    function inViewNum(el) {
      var r = el.getBoundingClientRect();
      return r.top < (window.innerHeight || document.documentElement.clientHeight) && r.bottom > 0;
    }

    function fire(el) {
      if (el.dataset.fired) return;
      el.dataset.fired = '1';
      run(el);
    }

    if (!('IntersectionObserver' in window)) {
      nodes.forEach(run);
      return;
    }

    var io2 = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { fire(e.target); io2.unobserve(e.target); }
      });
    }, { threshold: 0.25, rootMargin: '0px 0px -8% 0px' });

    nodes.forEach(function (n) {
      io2.observe(n);
      if (inViewNum(n)) fire(n);
      setTimeout(function () { fire(n); }, 1600);
    });
  })();
</script>

<style>
  .section-head {
    max-width: 50em;
    margin: 0 auto 56px;
  }

  .section-head.center {
    text-align: center;
  }

  .viz-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .barchart {
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: 32px 36px 28px;
    box-shadow: 0 4px 14px -8px rgba(11, 15, 26, 0.06);
  }

  .barchart h3 {
    font: 600 1.4rem/1.2 var(--font-display);
    color: var(--ink-900);
    letter-spacing: -0.012em;
    margin: 0 0 6px;
  }

  .barchart-sub {
    font: 400 0.95rem/1.4 var(--font-body);
    color: var(--ink-700);
    margin: 0 0 28px;
  }

  .bar-row {
    display: grid;
    grid-template-columns: minmax(140px, 220px) 1fr 56px;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px dashed rgba(18, 24, 38, 0.08);
  }

  .bar-row:last-child {
    border-bottom: 0;
  }

  .bar-label {
    font: 500 0.9rem/1.3 var(--font-body);
    color: var(--ink-900);
  }

  .bar-label small {
    display: block;
    font: 400 0.72rem/1.2 var(--font-ui);
    color: var(--fg-subtle);
    margin-top: 3px;
  }

  .bar-track {
    position: relative;
    height: 26px;
    background: rgba(18, 24, 38, 0.05);
    border-radius: 4px;
    overflow: hidden;
  }

  .bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 4px;
    transition: width 1.2s var(--ease-out);
  }

  .bar-fill.moss {
    background: linear-gradient(90deg, var(--moss-500), var(--moss-300));
  }

  .bar-fill.clay {
    background: linear-gradient(90deg, var(--clay-500), var(--clay-300));
  }

  .bar-fill.maroon {
    background: linear-gradient(90deg, var(--maroon-500), var(--maroon-300));
  }

  .bar-value {
    font: 700 0.95rem/1 var(--font-mono);
    color: var(--ink-900);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .stat-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 14px;
  }

  .stat-card {
    padding: 26px 22px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .stat-card .stat-num {
    display: block;
    font: 600 clamp(2rem, 2.4vw + 0.8rem, 2.8rem)/1 var(--font-display);
    color: var(--clay-600);
    letter-spacing: -0.028em;
    margin-bottom: 10px;
    font-variant-numeric: tabular-nums;
  }

  .stat-card .stat-lbl {
    display: block;
    font: 400 0.92rem/1.45 var(--font-body);
    color: var(--ink-700);
  }

  @media (max-width: 980px) {
    .viz-grid { grid-template-columns: 1fr; }
    .stat-cards { grid-template-columns: repeat(4, 1fr); }
  }

  @media (max-width: 760px) {
    .bar-row { grid-template-columns: 1fr; gap: 8px; }
    .bar-value { text-align: left; }
    .stat-cards { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 480px) {
    .stat-cards { grid-template-columns: 1fr; }
  }
</style>
