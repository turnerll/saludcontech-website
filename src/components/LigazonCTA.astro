---
import SignupForm from './SignupForm.astro';
---

<section class="final-cta" id="final-cta">
  <div class="container-narrow">
    <h2>Join the community building what comes next.</h2>
    <p>
      Founders, clinicians, funders, operators. If you believe the people closest to the problems should own the solutions, you belong here.
    </p>
    <div class="cta-form-wrap">
      <SignupForm interest="footer-cta" buttonText="Join SaludConTech" />
    </div>
    <div class="btn-row">
      <a href="/community" class="btn btn-primary">See membership</a>
      <a href="/contact" class="btn btn-secondary" style="border-color: rgba(244,239,227,0.5); color: var(--paper-50);">Partner with us</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: 100px 0;
    text-align: center;
    background: var(--ink-900);
    color: var(--paper-50);
    position: relative;
    overflow: hidden;
  }

  .final-cta::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -100px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(122, 38, 50, 0.24), transparent);
    filter: blur(80px);
  }

  .final-cta::after {
    content: "";
    position: absolute;
    bottom: -100px;
    left: -100px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(212, 162, 62, 0.16), transparent);
    filter: blur(80px);
  }

  .final-cta .container-narrow {
    position: relative;
  }

  .final-cta h2 {
    font: 600 clamp(2.2rem, 3.4vw + 1rem, 3.4rem)/1.05 var(--font-display);
    color: var(--paper-50);
    letter-spacing: -0.026em;
    margin: 0 auto 18px;
    text-wrap: balance;
    max-width: 16ch;
  }

  .final-cta p {
    font: 400 1.15rem/1.55 var(--font-body);
    color: rgba(244, 239, 227, 0.72);
    max-width: 36em;
    margin: 0 auto 36px;
  }

  .cta-form-wrap {
    max-width: 720px;
    margin: 0 auto 28px;
    padding: 24px;
    background: rgba(12, 31, 22, 0.45);
    border: 1px solid rgba(212, 162, 62, 0.3);
    border-radius: var(--radius-lg);
  }

  .cta-form-wrap .signup-foot {
    color: rgba(244, 239, 227, 0.55);
  }

  .btn-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .final-cta .btn-secondary:hover {
    background: rgba(244, 239, 227, 0.1);
    color: var(--paper-50);
  }

  @media (max-width: 560px) {
    .final-cta { padding: 72px 0; }
  }
</style>
