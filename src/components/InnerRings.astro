---
const rings = [
  {
    num: '1',
    title: 'Public',
    subtitle: 'Anyone',
    body: 'Website, newsletter, social media',
    cta: 'Sign up',
    featured: false,
  },
  {
    num: '2',
    title: 'Member',
    subtitle: 'Approved applicants',
    body: 'Slack workspace, virtual events',
    cta: 'Application + interview',
    featured: true,
  },
  {
    num: '3',
    title: 'Builder',
    subtitle: 'Active volunteers + founders',
    body: 'In-person dinners, mentorship, introductions',
    cta: '90-day sprint or founder app',
    featured: true,
  },
  {
    num: '4',
    title: 'Founding Circle',
    subtitle: 'Advisory board + early supporters',
    body: 'Strategic input, governance voice, founding recognition',
    cta: 'Invitation from Daniel',
    featured: 'highlight',
  },
];
---

<section class="section-block dark">
  <div class="container-narrow">
    <div class="section-head center">
      <span class="label">Inner rings of belonging</span>
      <h2 class="headline">Not everyone gets the same access. Deeper involvement earns deeper belonging.</h2>
    </div>

    <div class="rings-grid">
      {rings.map((ring) => (
        <div class:list={['ring-card', ring.featured === 'highlight' && 'ring-card--highlight', ring.featured === true && 'ring-card--featured']}>
          <div class="ring-num">{ring.num}</div>
          <h3>{ring.title}</h3>
          <p class="ring-subtitle">{ring.subtitle}</p>
          <p class="ring-body">{ring.body}</p>
          <div class="ring-cta">{ring.cta}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section-head {
    max-width: 50em;
    margin: 0 auto 56px;
  }

  .section-head.center {
    text-align: center;
  }

  .rings-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .ring-card {
    padding: 32px 26px;
    background: rgba(244, 239, 227, 0.05);
    border: 1px solid var(--rule-on-dark);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: all 0.2s var(--ease-out);
  }

  .ring-card:hover {
    transform: translateY(-3px);
    border-color: var(--saffron-500);
  }

  .ring-card--featured {
    border-color: rgba(212, 162, 62, 0.35);
  }

  .ring-card--highlight {
    background: rgba(122, 38, 50, 0.12);
    border-color: var(--maroon-500);
  }

  .ring-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font: 700 1rem/1 var(--font-ui);
    background: rgba(244, 239, 227, 0.1);
    color: rgba(244, 239, 227, 0.7);
    border: 1px solid rgba(244, 239, 227, 0.15);
  }

  .ring-card--featured .ring-num {
    background: rgba(212, 162, 62, 0.15);
    color: var(--saffron-500);
    border-color: var(--saffron-500);
  }

  .ring-card--highlight .ring-num {
    background: var(--maroon-500);
    color: var(--paper-50);
    border-color: var(--maroon-500);
  }

  .ring-card h3 {
    font: 600 1.25rem/1.2 var(--font-display);
    color: var(--paper-50);
    margin: 0 0 8px;
  }

  .ring-subtitle {
    font: 400 0.92rem/1.4 var(--font-body);
    color: rgba(244, 239, 227, 0.65);
    margin: 0 0 12px;
  }

  .ring-body {
    font: 400 0.85rem/1.5 var(--font-body);
    color: rgba(244, 239, 227, 0.55);
    margin: 0 0 18px;
  }

  .ring-cta {
    font: 600 0.75rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--saffron-500);
    padding-top: 16px;
    border-top: 1px solid rgba(244, 239, 227, 0.1);
  }

  @media (max-width: 980px) {
    .rings-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .rings-grid { grid-template-columns: 1fr; }
  }
</style>
