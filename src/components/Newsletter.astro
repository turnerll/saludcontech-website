<section class="section-padding bg-dark-100">
  <div class="container-narrow">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-white mb-4 fade-in tracking-tight">
        Stay in the Loop
      </h2>
      <p class="text-gray-400 mb-8 fade-in">
        Get monthly updates on community events, founder stories, and opportunities in Latino health tech.
      </p>

      <form
        id="newsletter-form"
        class="flex flex-col gap-3 fade-in"
        action="#"
        method="POST"
      >
        <input
          type="text"
          name="name"
          required
          placeholder="Your name"
          autocomplete="name"
          class="flex-1 px-5 py-3.5 rounded-lg border border-white/10 bg-white/5 text-white placeholder:text-gray-500
                 focus:outline-none focus:ring-2 focus:ring-purple/50 focus:border-purple transition-all"
        />
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            required
            placeholder="your@email.com"
            autocomplete="email"
            class="flex-1 px-5 py-3.5 rounded-lg border border-white/10 bg-white/5 text-white placeholder:text-gray-500
                   focus:outline-none focus:ring-2 focus:ring-purple/50 focus:border-purple transition-all"
          />
          <button type="submit" class="btn-primary whitespace-nowrap">
            Subscribe
          </button>
        </div>
      </form>

      <p class="text-gray-600 text-xs mt-4 fade-in">
        No spam. Unsubscribe anytime.
      </p>

      <!-- Success message (hidden by default) -->
      <div id="newsletter-success" class="hidden mt-4 p-4 bg-purple/10 border border-purple/20 text-purple-300 rounded-lg text-sm font-medium">
        Thanks for subscribing! Check your inbox for a confirmation.
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('newsletter-form')?.addEventListener('submit', function (e) {
      e.preventDefault();
      var form = e.target;
      var name = form.name.value.trim();
      var email = form.email.value.trim();
      var payload = {
        name: name,
        email: email,
        source: 'saludcontech.com',
        interest: 'newsletter',
      };

      // Supabase anon insert into public.signups (IP/UA captured by trigger)
      fetch('https://jcxagmhvwakkxogfyrzv.supabase.co/rest/v1/signups', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpjeGFnbWh2d2Fra3hvZ2Z5cnp2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODExMTQ5MTAsImV4cCI6MjA5NjY5MDkxMH0.G_iv7_Z5_TSHN7HeXsTuExRjs3edyCfPJwCc3xwc2rM',
          'Prefer': 'return=minimal',
        },
        body: JSON.stringify(payload),
      })
        .then(function (res) {
          if (res.ok) {
            if (window.posthog) {
              posthog.identify(email, { name: name, email: email, source: 'saludcontech.com' });
              posthog.capture('relaunch_signup', { name: name, email: email, interest: 'newsletter' });
            }
            form.classList.add('hidden');
            document.getElementById('newsletter-success')?.classList.remove('hidden');
          } else {
            throw new Error('Signup failed: ' + res.status);
          }
        })
        .catch(function (err) {
          console.error(err);
          alert('Something went wrong. Please try again.');
        });
    });
  </script>
</section>
