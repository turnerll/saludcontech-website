---
const currentYear = new Date().getFullYear();

const navLinks = [
  { label: 'About', href: '/about' },
  { label: 'Community', href: '/community' },
  { label: 'Volunteer', href: '/volunteer' },
  { label: 'Contact', href: '/contact' },
];

const connectLinks = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/saludcontech/' },
  { label: 'Instagram', href: 'https://www.instagram.com/saludcontech/' },
  { label: 'Slack', href: 'https://saludcontech.slack.com' },
];
---

<footer class="site-footer">
  <div class="container-narrow">
    <div class="foot-grid">
      <div class="foot-col foot-brand">
        <span class="brand-mark">SCT</span>
        <p>
          The cross-industry Latino entrepreneurship community. Founders, funders, operators, and builders with health as the common thread.
        </p>
        <p class="foot-honest">
          All figures on this site come from SaludConTech records or cited public research. Unverified claims are not shown.
        </p>
      </div>

      <div class="foot-col">
        <h4>Navigate</h4>
        <ul>
          {navLinks.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="foot-col">
        <h4>Connect</h4>
        <ul>
          {connectLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="foot-col">
        <h4>Contact</h4>
        <ul>
          <li><a href="mailto:djtl@saludcontech.com">djtl@saludcontech.com</a></li>
          <li><span>Los Angeles, CA</span></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      &copy; {currentYear} SaludConTech. Part of the Cultura Holdings ecosystem.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-950);
    color: var(--paper-50);
    padding: 64px 0 40px;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 2fr minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }

  .foot-col h4 {
    font: 600 0.78rem/1 var(--font-ui);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--saffron-200);
    margin: 0 0 16px;
  }

  .foot-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .foot-col li {
    padding: 5px 0;
  }

  .foot-col a,
  .foot-col span {
    font: 400 0.88rem/1.4 var(--font-body);
    color: rgba(244, 239, 227, 0.7);
    text-decoration: none;
    transition: color 0.15s;
  }

  .foot-col a:hover {
    color: var(--saffron-200);
  }

  .foot-brand .brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--maroon-500);
    color: var(--paper-50);
    font: 700 0.9rem/1 var(--font-ui);
    border-radius: var(--radius);
    margin-bottom: 14px;
  }

  .foot-brand p {
    font: 400 0.88rem/1.55 var(--font-body);
    color: rgba(244, 239, 227, 0.65);
    margin: 0;
    max-width: 26em;
  }

  .foot-brand .foot-honest {
    font-size: 0.78rem;
    color: rgba(244, 239, 227, 0.48);
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(244, 239, 227, 0.12);
  }

  .foot-bottom {
    margin-top: 56px;
    padding-top: 22px;
    border-top: 1px solid rgba(244, 239, 227, 0.1);
    font: 400 0.8rem/1.4 var(--font-body);
    color: rgba(244, 239, 227, 0.5);
  }

  @media (max-width: 980px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .foot-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
