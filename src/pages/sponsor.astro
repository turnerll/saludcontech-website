---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Sponsor | SaludConTech" description="SaludConTech is being rebuilt. Sign up for updates.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Sponsor"
      title="SaludConTech is being rebuilt."
      subtitle="SaludConTech does not take sponsorships today. To talk, write to us from the contact page."
    />
    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>
