---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
import { SCT_FACTS } from '../data/sctFacts';

const photos = [
  { src: '/photos/symposium-stage-talk.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-panel.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-audience-speaker.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-room.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-audience-one.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-audience-two.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-group.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-panel-close.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-wide.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-audience.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-dialogue.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-panel-wide.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-roundtable.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-breakout.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-breakout-speaker.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-registration.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-celebration.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-breakout-audience.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-networking-one.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-networking-two.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-panel-stage.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-keynote-wide.jpg', alt: 'Photo from a past SaludConTech gathering' },
  { src: '/photos/symposium-stage-closing.jpg', alt: 'Photo from a past SaludConTech gathering' },
];
---

<Layout title="Photos | SaludConTech" description="Photos from past SaludConTech gatherings.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="The archive"
      title="From the archive"
      subtitle={`Founded in ${SCT_FACTS.founded.value}, SaludConTech began by bringing founders, funders, clinicians, and operators into the same room.`}
    />

    <section class="section-block intro-section">
      <div class="reading-col archive-intro">
        <p>
          Photos from past SaludConTech gatherings, recovered from our archive.
        </p>
      </div>
    </section>

    <section class="gallery-section" aria-label="SaludConTech photo archive">
      <div class="container-narrow photo-grid">
        {photos.map((photo, index) => (
          <figure class:list={['photo-card', index === 0 && 'photo-card-wide']}>
            <img src={photo.src} alt={photo.alt} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
            <figcaption>SaludConTech gathering</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section-block closing-section">
      <div class="reading-col closing-copy">
        <h2 class="headline">Hear what comes next.</h2>
        <p>Leave your name and email to hear first.</p>
        <a href="/#join-now" class="btn btn-primary">Sign up for updates</a>
      </div>
    </section>
  </main>
  <LigazonFooter />
</Layout>

<style>
  .intro-section {
    padding-bottom: 56px;
  }

  .archive-intro {
    font: var(--body-lg);
    color: var(--ink-700);
    text-wrap: pretty;
  }

  .gallery-section {
    padding: 0 0 104px;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 18px;
  }

  .photo-card {
    grid-column: span 4;
    margin: 0;
    overflow: hidden;
    background: var(--ink-950);
    border-radius: var(--radius-lg);
    position: relative;
    min-height: 330px;
  }

  .photo-card-wide {
    grid-column: span 8;
  }

  .photo-card img {
    width: 100%;
    height: 100%;
    min-height: 330px;
    object-fit: cover;
    display: block;
    transition: transform 0.45s var(--ease-out);
  }

  .photo-card:hover img {
    transform: scale(1.025);
  }

  .photo-card figcaption {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 8px 11px;
    border-radius: var(--radius);
    background: rgba(11, 15, 26, 0.82);
    color: var(--paper-50);
    font: 600 0.72rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .closing-section {
    background: var(--paper-100);
  }

  .closing-copy {
    text-align: center;
  }

  .closing-copy p {
    margin: 18px 0 28px;
    font: var(--body-lg);
    color: var(--ink-700);
  }

  @media (max-width: 900px) {
    .photo-card,
    .photo-card-wide {
      grid-column: span 6;
    }
  }

  @media (max-width: 620px) {
    .photo-grid {
      gap: 12px;
    }

    .photo-card,
    .photo-card-wide {
      grid-column: 1 / -1;
      min-height: 280px;
    }

    .photo-card img {
      min-height: 280px;
    }
  }
</style>
