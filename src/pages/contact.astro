---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Contact - SaludConTech" description="Get in touch with SaludConTech. Apply to join, partner with us, or ask a question.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Get in touch"
      title="Let's connect."
      subtitle="Whether you want to join the community, volunteer, partner, or just say hello, we would love to hear from you."
    />

    <section class="section-block">
      <div class="container-narrow">
        <div class="contact-grid">
          <div class="contact-form-wrap">
            <form
              id="contact-form"
              class="contact-form"
              action="https://formsubmit.co/djtl@saludcontech.com"
              method="POST"
            >
              <input type="hidden" name="_subject" value="New SaludConTech Contact Form Submission" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_next" value="https://saludcontech.com/contact?submitted=true" />
              <input type="hidden" name="_template" value="table" />
              <input type="text" name="_honey" style="display:none" />

              <div class="form-row">
                <div class="field">
                  <label for="name">Name</label>
                  <input type="text" id="name" name="name" required placeholder="Your name" />
                </div>
                <div class="field">
                  <label for="email">Email</label>
                  <input type="email" id="email" name="email" required placeholder="your@email.com" />
                </div>
              </div>

              <div class="field">
                <label for="subject">I am interested in...</label>
                <select id="subject" name="subject">
                  <option value="Joining the Community">Joining the Community</option>
                  <option value="Volunteering">Volunteering</option>
                  <option value="Corporate Partnership">Corporate Partnership</option>
                  <option value="Advisory Board">Advisory Board</option>
                  <option value="Media / Press">Media / Press</option>
                  <option value="Something Else">Something Else</option>
                </select>
              </div>

              <div class="field">
                <label for="message">Message</label>
                <textarea id="message" name="message" rows="5" required placeholder="Tell us about yourself and how we can help..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary">
                Send message
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M13 7l5 5m0 0l-5 5m5-5H6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>

            <div id="contact-success" class="contact-success hidden" hidden>
              <p class="contact-success-title">Message sent!</p>
              <p class="contact-success-body">We will get back to you within 48 hours.</p>
            </div>
          </div>

          <aside class="contact-info">
            <div class="info-block">
              <h3>Email</h3>
              <a href="mailto:djtl@saludcontech.com">djtl@saludcontech.com</a>
            </div>
            <div class="info-block">
              <h3>Location</h3>
              <p>Los Angeles, California</p>
            </div>
            <div class="info-block">
              <h3>Follow us</h3>
              <div class="social-links">
                <a href="https://www.linkedin.com/company/saludcontech/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                </a>
                <a href="https://www.instagram.com/saludcontech/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                </a>
                <a href="https://saludcontech.slack.com" target="_blank" rel="noopener noreferrer" aria-label="Slack">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5.042 15.165a2.528 2.528 0 0 1-2.52 2.523A2.528 2.528 0 0 1 0 15.165a2.527 2.527 0 0 1 2.522-2.52h2.52v2.52zM6.313 15.165a2.527 2.527 0 0 1 2.521-2.52 2.527 2.527 0 0 1 2.521 2.52v6.313A2.528 2.528 0 0 1 8.834 24a2.528 2.528 0 0 1-2.521-2.522v-6.313zM8.834 5.042a2.528 2.528 0 0 1-2.521-2.52A2.528 2.528 0 0 1 8.834 0a2.528 2.528 0 0 1 2.521 2.522v2.52H8.834zM8.834 6.313a2.528 2.528 0 0 1 2.521 2.521 2.528 2.528 0 0 1-2.521 2.521H2.522A2.528 2.528 0 0 1 0 8.834a2.528 2.528 0 0 1 2.522-2.521h6.312zM18.956 8.834a2.528 2.528 0 0 1 2.522-2.521A2.528 2.528 0 0 1 24 8.834a2.528 2.528 0 0 1-2.522 2.521h-2.522V8.834zM17.688 8.834a2.528 2.528 0 0 1-2.523 2.521 2.527 2.527 0 0 1-2.52-2.521V2.522A2.527 2.527 0 0 1 15.165 0a2.528 2.528 0 0 1 2.523 2.522v6.312zM15.165 18.956a2.528 2.528 0 0 1 2.523 2.522A2.528 2.528 0 0 1 15.165 24a2.527 2.527 0 0 1-2.52-2.522v-2.522h2.52zM15.165 17.688a2.527 2.527 0 0 1-2.52-2.523 2.526 2.526 0 0 1 2.52-2.52h6.313A2.527 2.527 0 0 1 24 15.165a2.528 2.528 0 0 1-2.522 2.523h-6.313z"/></svg>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <LigazonFooter />

  <script is:inline>
    (function () {
      if (window.location.search.indexOf('submitted=true') !== -1) {
        var form = document.getElementById('contact-form');
        var success = document.getElementById('contact-success');
        if (form) form.classList.add('hidden');
        if (success) {
          success.classList.remove('hidden');
          success.hidden = false;
        }
      }

      var form = document.getElementById('contact-form');
      if (form) {
        form.addEventListener('submit', function () {
          var email = document.getElementById('email')?.value;
          if (email && window.posthog) {
            posthog.identify(email, { email: email, source: 'saludcontech.com' });
          }
        });
      }
    })();
  </script>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .field label {
    font: 600 0.85rem/1 var(--font-ui);
    color: var(--ink-800);
  }

  .field input,
  .field select,
  .field textarea {
    font: 500 1rem/1.2 var(--font-body);
    padding: 14px 16px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    color: var(--ink-900);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--maroon-500);
    box-shadow: 0 0 0 3px rgba(122, 38, 50, 0.12);
  }

  .field textarea {
    resize: none;
  }

  .contact-success {
    padding: 28px;
    background: var(--moss-50);
    border: 1px solid var(--moss-100);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .contact-success.hidden {
    display: none;
  }

  .contact-success-title {
    font: 600 1.3rem/1.2 var(--font-display);
    color: var(--moss-500);
    margin: 0 0 8px;
  }

  .contact-success-body {
    font: 400 1rem/1.5 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .info-block h3 {
    font: 600 0.85rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-800);
    margin: 0 0 10px;
  }

  .info-block a,
  .info-block p {
    font: 400 1.05rem/1.5 var(--font-body);
    color: var(--ink-700);
    margin: 0;
    text-decoration: none;
  }

  .info-block a:hover {
    color: var(--maroon-500);
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-links a {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-700);
    transition: all 0.2s;
  }

  .social-links a:hover {
    background: var(--maroon-500);
    border-color: var(--maroon-500);
    color: var(--paper-50);
  }

  @media (max-width: 980px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
