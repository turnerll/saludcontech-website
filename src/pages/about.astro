---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="About | SaludConTech" description="SaludConTech was founded in Los Angeles in 2018 by people building health and technology for Latino communities.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Our story"
      title="The people closest to the problems should own the solutions."
      subtitle="SaludConTech brought together Latino founders, clinicians, funders, and operators in health."
    />

    <section class="section-block">
      <div class="reading-col">
        <p class="body-text" style="font-size: 1.18rem; margin-bottom: 24px;">
          Founded in 2018, SaludConTech grew from a simple belief: the people closest to a community's health challenges should be the ones building the companies that solve them.
        </p>
        <p class="body-text">
          Photos from past SaludConTech gatherings are in <a href="/photos">our archive</a>. What comes next is being built now. <a href="/#join-now">Sign up for updates</a> to hear first.
        </p>
      </div>
    </section>

    <section class="section-block alt">
      <div class="container-narrow">
        <div class="section-head center">
          <span class="label">Founder</span>
        </div>
        <div class="team-grid">
          <div class="team-card">
            <div class="team-avatar">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <h3>Daniel Turner-Lloveras, MD</h3>
            <p class="team-role">Co-Founder and CEO</p>
            <p class="team-bio">Physician in Los Angeles.</p>
          </div>
        </div>
      </div>
    </section>

    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 48px;
  }

  .team-card {
    padding: 32px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: all 0.2s var(--ease-out);
  }

  .team-card:hover {
    transform: translateY(-3px);
    border-color: var(--clay-500);
  }

  .team-card--open {
    border-style: dashed;
    border-color: var(--rule-strong);
  }

  .team-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--paper-100);
    color: var(--clay-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
  }

  .team-card h3 {
    font: 600 1.25rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 6px;
  }

  .team-role {
    font: 600 0.78rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--maroon-500);
    margin: 0 0 14px;
  }

  .team-bio {
    font: 400 0.95rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .team-link {
    display: inline-block;
    margin-top: 14px;
    font: 600 0.9rem/1 var(--font-ui);
    color: var(--maroon-500);
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .team-grid { grid-template-columns: 1fr; }
  }
</style>
