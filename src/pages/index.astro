---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import LigazonHero from '../components/LigazonHero.astro';
import LigazonDataViz from '../components/LigazonDataViz.astro';
import LigazonPillars from '../components/LigazonPillars.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="SaludConTech | Latino Entrepreneurship Community" description="The network where US Latino health tech gets built, funded, and scaled. Founders, funders, and operators, with health as the common thread. 336 active members.">
  <LigazonHeader />
  <main>
    <LigazonHero />
    <LigazonDataViz />
    <LigazonPillars />
    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>
