---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import LigazonHero from '../components/LigazonHero.astro';
import LigazonDataViz from '../components/LigazonDataViz.astro';
import LigazonPillars from '../components/LigazonPillars.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="SaludConTech — Latino Entrepreneurship Community" description="The cross-industry Latino entrepreneurship community. Founders, funders, operators, and builders with health as the common thread. 659 members. 10 city chapters.">
  <LigazonHeader />
  <main>
    <LigazonHero />
    <LigazonDataViz />
    <LigazonPillars />
    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>
