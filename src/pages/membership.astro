---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Membership | SaludConTech" description="SaludConTech is being rebuilt. Sign up for updates.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Membership"
      title="SaludConTech is being rebuilt."
      subtitle="There is no membership program today. Leave your name and email to hear what comes next."
    />
    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>
