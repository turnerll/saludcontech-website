---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import SignupForm from '../components/SignupForm.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Membership | SaludConTech" description="A curated, invite-only community for Latino founders, clinicians, funders, and operators building in health. 336 active members.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Membership"
      title="A curated room for Latino health innovation."
      subtitle="Founders, clinicians, funders, and operators from across industries. Health is the common thread."
    />

    <section class="section-block">
      <div class="container-narrow">
        <div class="section-head center">
          <span class="label">Who it is for</span>
          <h2 class="headline">Four profiles. One conviction.</h2>
        </div>
        <div class="audience-grid">
          <div class="audience-card">
            <h3>Founders</h3>
            <p>You are building a company that serves the community you come from.</p>
          </div>
          <div class="audience-card">
            <h3>Funders</h3>
            <p>You invest in markets others overlook because they do not know them.</p>
          </div>
          <div class="audience-card">
            <h3>Operators</h3>
            <p>You run the teams and systems that make health work.</p>
          </div>
          <div class="audience-card">
            <h3>Clinicians and builders</h3>
            <p>You practice at the bedside and build at the keyboard.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-block alt">
      <div class="container-narrow">
        <div class="section-head center">
          <span class="label">What membership means</span>
          <h2 class="headline">Access, not content.</h2>
        </div>
        <div class="value-grid">
          <div class="value-item">
            <span class="value-tag">Workspace</span>
            <h3>Vetted Slack community</h3>
            <p>A workspace where members share customers, co-founders, and capital. No noise. No spam.</p>
          </div>
          <div class="value-item">
            <span class="value-tag">Rooms</span>
            <h3>Pitch rooms and build nights</h3>
            <p>Small rooms where founders present and operators respond. Los Angeles first, dates announced to members.</p>
          </div>
          <div class="value-item">
            <span class="value-tag">Introductions</span>
            <h3>Warm introductions</h3>
            <p>Direct introductions to operators and capital. Never a fee, never a cut of a round.</p>
          </div>
          <div class="value-item">
            <span class="value-tag">Recognition</span>
            <h3>Founding member status</h3>
            <p>Early members get locked-in recognition as the community scales.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="reading-col">
        <div class="section-head" style="margin-bottom: 32px;">
          <span class="label">The standard</span>
          <h2 class="headline">Every application is reviewed by a human.</h2>
        </div>
        <p class="body-text" style="font-size: 1.18rem; margin-bottom: 24px;">
          We keep the room small on purpose. Quality over scale. The right people, not the most people.
        </p>
        <p class="body-text" style="margin-bottom: 24px;">
          If you are building, funding, or operating in and for Latino communities, you belong here. The application takes five minutes. We read every submission and respond within a week.
        </p>
        <p class="body-text">
          This is not a volume play. It is a room you want to be in because the people inside are doing the work.
        </p>
      </div>
    </section>

    <section class="section-block alt">
      <div class="container-narrow">
        <div class="proof-grid">
          <div class="proof-card">
            <span class="proof-num">336</span>
            <span class="proof-lbl">Active members</span>
          </div>
          <div class="proof-card">
            <span class="proof-num">2018</span>
            <span class="proof-lbl">Founded</span>
          </div>
          <div class="proof-card">
            <span class="proof-num">HIMSS25</span>
            <span class="proof-lbl">Collaborator</span>
          </div>
        </div>
      </div>
    </section>

    <section class="final-cta">
      <div class="container-narrow">
        <h2>Request an invite</h2>
        <p>Tell us who you are and what you are building. We read every application.</p>
        <div class="cta-form-wrap">
          <SignupForm interest="membership" buttonText="Request an invite" />
        </div>
      </div>
    </section>
  </main>
  <LigazonFooter />
</Layout>

<style>
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .audience-card {
    padding: 28px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-align: center;
    transition: all 0.2s var(--ease-out);
  }

  .audience-card:hover {
    transform: translateY(-3px);
    border-color: var(--clay-500);
  }

  .audience-card h3 {
    font: 600 1.15rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 10px;
  }

  .audience-card p {
    font: 400 0.96rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 48px;
  }

  .value-item {
    padding: 28px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    transition: all 0.2s var(--ease-out);
  }

  .value-item:hover {
    transform: translateY(-3px);
    border-color: var(--clay-500);
    box-shadow: 0 18px 36px -18px rgba(11, 15, 26, 0.18);
  }

  .value-tag {
    font: 600 0.7rem/1 var(--font-ui);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--maroon-500);
    display: block;
    margin-bottom: 12px;
  }

  .value-item h3 {
    font: 600 1.2rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 10px;
  }

  .value-item p {
    font: 400 0.96rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .proof-card {
    padding: 32px 22px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .proof-num {
    display: block;
    font: 600 clamp(1.6rem, 2vw + 0.6rem, 2.4rem)/1 var(--font-display);
    color: var(--clay-600);
    letter-spacing: -0.02em;
    margin-bottom: 10px;
  }

  .proof-lbl {
    display: block;
    font: 400 0.92rem/1.45 var(--font-body);
    color: var(--ink-700);
  }

  .final-cta {
    padding: 100px 0;
    text-align: center;
    background: var(--ink-900);
    color: var(--paper-50);
    position: relative;
    overflow: hidden;
  }

  .final-cta::before {
    content: "";
    position: absolute;
    top: -100px;
    right: -100px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(122, 38, 50, 0.24), transparent);
    filter: blur(80px);
  }

  .final-cta::after {
    content: "";
    position: absolute;
    bottom: -100px;
    left: -100px;
    width: 460px;
    height: 460px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(212, 162, 62, 0.16), transparent);
    filter: blur(80px);
  }

  .final-cta .container-narrow {
    position: relative;
  }

  .final-cta h2 {
    font: 600 clamp(2.2rem, 3.4vw + 1rem, 3.4rem)/1.05 var(--font-display);
    color: var(--paper-50);
    letter-spacing: -0.026em;
    margin: 0 auto 18px;
    text-wrap: balance;
    max-width: 16ch;
  }

  .final-cta p {
    font: 400 1.15rem/1.55 var(--font-body);
    color: rgba(244, 239, 227, 0.72);
    max-width: 36em;
    margin: 0 auto 36px;
  }

  .cta-form-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px;
    background: rgba(12, 31, 22, 0.45);
    border: 1px solid rgba(212, 162, 62, 0.3);
    border-radius: var(--radius-lg);
  }

  .cta-form-wrap .signup-foot {
    color: rgba(244, 239, 227, 0.55);
  }

  @media (max-width: 980px) {
    .audience-grid { grid-template-columns: 1fr 1fr; }
    .value-grid { grid-template-columns: 1fr 1fr; }
    .proof-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 640px) {
    .audience-grid { grid-template-columns: 1fr; }
    .value-grid { grid-template-columns: 1fr; }
    .proof-grid { grid-template-columns: 1fr 1fr; }
    .final-cta { padding: 72px 0; }
  }
</style>
