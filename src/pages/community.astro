---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Community | SaludConTech" description="Sign up for SaludConTech updates.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Community"
      title="Hear what comes next."
      subtitle="Leave your name and email."
    />
    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>
