---
import Layout from '../layouts/Layout.astro';
import LigazonHeader from '../components/LigazonHeader.astro';
import PageHeader from '../components/PageHeader.astro';
import InnerRings from '../components/InnerRings.astro';
import LigazonCTA from '../components/LigazonCTA.astro';
import LigazonFooter from '../components/LigazonFooter.astro';
---

<Layout title="Community | SaludConTech" description="Join 659 Latino founders, clinicians, funders, and builders across 10 city chapters. Monthly calls, sobremesa dinners, and a vetted Slack workspace.">
  <LigazonHeader />
  <main>
    <PageHeader
      eyebrow="Join us"
      title="A community that gets it."
      subtitle="Not a networking event. A gathering place where people can be their full selves, speak Spanglish, share frustrations about the system, and find collaborators who understand."
    />

    <section class="section-block">
      <div class="container-narrow">
        <div class="principles-grid">
          <div class="principle">
            <h3>Shared values</h3>
            <p>If you believe the people building technology should reflect the communities it serves, you belong here.</p>
          </div>
          <div class="principle">
            <h3>Sacred space</h3>
            <p>Our Slack workspace and dinners are gathering places where people can be their full selves and find collaborators who get it.</p>
          </div>
          <div class="principle">
            <h3>Earned belonging</h3>
            <p>The application and interview are intentional friction. People who go through a selection process value their membership more.</p>
          </div>
          <div class="principle">
            <h3>Our rituals</h3>
            <p>Monthly virtual calls, quarterly LA dinners, weekly Monday Slack prompts, and personal welcome DMs within 24 hours.</p>
          </div>
        </div>
      </div>
    </section>

    <div class="section-block dark" style="padding-top: 0; padding-bottom: 0;">
      <InnerRings />
    </div>

    <section class="section-block alt">
      <div class="container-narrow">
        <div class="section-head center">
          <span class="label">How to join</span>
          <h2 class="headline">Three steps to membership</h2>
        </div>
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <h3>Apply</h3>
            <p>Fill out our short application form. Tell us about yourself, your work, and why you want to join.</p>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <h3>Brief interview</h3>
            <p>A 15-minute chat to make sure we are a good fit for each other. We want to know your story.</p>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <h3>Welcome to Slack</h3>
            <p>Get access to our Slack workspace, a personal welcome DM, and an introduction to the community.</p>
          </div>
        </div>
        <div class="text-center mt-12">
          <a href="/contact" class="btn btn-primary text-lg">Apply now</a>
        </div>
      </div>
    </section>

    <section class="section-block">
      <div class="container-narrow">
        <div class="section-head center">
          <span class="label">Events</span>
          <h2 class="headline">What we do together</h2>
        </div>
        <div class="events-grid">
          <div class="event-card">
            <h3>Monthly Virtual Call</h3>
            <p>30 minutes, informal, share wins and ask for help. Open to all members.</p>
            <span class="event-tag">Every month</span>
          </div>
          <div class="event-card">
            <h3>Sobremesa Dinner (LA)</h3>
            <p>Curated in-person dinner for 12-15 people. Builders only. Quarterly in Los Angeles.</p>
            <span class="event-tag">Quarterly in LA</span>
          </div>
        </div>
      </div>
    </section>

    <LigazonCTA />
  </main>
  <LigazonFooter />
</Layout>

<style>
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .principle {
    padding: 28px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--clay-500);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .principle h3 {
    font: 600 1.2rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 10px;
  }

  .principle p {
    font: 400 1rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    max-width: 900px;
    margin: 0 auto;
  }

  .step {
    text-align: center;
    padding: 32px 24px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  .step-num {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--maroon-500);
    color: var(--paper-50);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 700 1rem/1 var(--font-ui);
    margin: 0 auto 16px;
  }

  .step h3 {
    font: 600 1.2rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 10px;
  }

  .step p {
    font: 400 0.96rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    max-width: 900px;
    margin: 0 auto;
  }

  .event-card {
    padding: 32px;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
  }

  .event-card h3 {
    font: 600 1.3rem/1.2 var(--font-display);
    color: var(--ink-900);
    margin: 0 0 10px;
  }

  .event-card p {
    font: 400 1rem/1.55 var(--font-body);
    color: var(--ink-700);
    margin: 0 0 16px;
  }

  .event-tag {
    font: 600 0.75rem/1 var(--font-ui);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--maroon-500);
  }

  .text-center {
    text-align: center;
  }

  .mt-12 {
    margin-top: 48px;
  }

  @media (max-width: 980px) {
    .principles-grid,
    .steps,
    .events-grid { grid-template-columns: 1fr; }
  }
</style>
